{
  "name": "dsh-stock-assistant",
  "version": "0.1.0",
  "description": "东方财富 + 腾讯行情数据源：A股行情/热点/技术分析/自选股盯盘助手（DSH 插件，含设置卡片）",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fxxg023/dsh-stock-assistant.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "stock",
    "a-share",
    "eastmoney",
    "akshare",
    "quant"
  ],
  "files": [
    "index.js",
    "src",
    "py",
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:client": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.5 || ^0.1.0-rc.6 || ^0.0.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.5 || ^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/react": "~18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0"
  }
}
